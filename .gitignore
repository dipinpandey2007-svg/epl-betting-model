# Environments and build artefacts
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Football data: not redistributed until football-data.co.uk terms are verified.
# Recreate with `python -m eplmodel.data.download` and `python -m eplmodel.data.build`;
# data/checksums.json records the exact content used for all results.
data/raw/
data/processed/

# Sealed final holdout data (docs/HOLDOUT_PROTOCOL.md). Only data/holdout_manifest.json,
# which records their checksums, is committed.
data/holdout/

# Per-match predictions are derived from third-party match data; metrics.json records their checksum.
results/*/predictions.csv
